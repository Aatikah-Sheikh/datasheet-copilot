# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
# Optional: enables web search for datasheets and alternative parts.
TAVILY_API_KEY=

# Hard token caps (prompt + completion); requests are refused once reached.
# MAX_TOKENS_PER_SESSION=100000
# MAX_TOKENS_PER_DAY=300000
# MAX_TOKENS_TOTAL=1000000

# Optional overrides. Run `python scripts/check_setup.py` to see the IDs your key can use.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
